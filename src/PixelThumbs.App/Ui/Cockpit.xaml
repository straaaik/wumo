<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Canvas" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="Panel" Color="#101010"/>
    <SolidColorBrush x:Key="Bar" Color="#131313"/>
    <SolidColorBrush x:Key="Raised" Color="#171717"/>
    <SolidColorBrush x:Key="DialogBody" Color="#18181C"/>
    <SolidColorBrush x:Key="DialogField" Color="#141416"/>
    <SolidColorBrush x:Key="DialogLine" Color="#26262B"/>
    <SolidColorBrush x:Key="Sand" Color="#D2CCBB"/>
    <SolidColorBrush x:Key="Secondary" Color="#B9B4A5"/>
    <SolidColorBrush x:Key="Muted" Color="#A49F92"/>
    <SolidColorBrush x:Key="Quiet" Color="#827E74"/>
    <SolidColorBrush x:Key="Disabled" Color="#737373"/>
    <SolidColorBrush x:Key="Hairline" Color="#0DD2CCBB"/>
    <SolidColorBrush x:Key="Line" Color="#1AD2CCBB"/>
    <SolidColorBrush x:Key="Frame" Color="#26D2CCBB"/>
    <SolidColorBrush x:Key="HoverLine" Color="#33D2CCBB"/>
    <SolidColorBrush x:Key="FocusLine" Color="#66D2CCBB"/>
    <SolidColorBrush x:Key="Cyan" Color="#00D3F3"/>
    <SolidColorBrush x:Key="Green" Color="#00D492"/>
    <SolidColorBrush x:Key="Amber" Color="#FFB900"/>
    <SolidColorBrush x:Key="Rose" Color="#FF637E"/>
    <CornerRadius x:Key="Radius">4</CornerRadius>
    <CornerRadius x:Key="PanelRadius">8</CornerRadius>
    <FontFamily x:Key="Sans">/PixelThumbs;component/fonts/#Inter</FontFamily>
    <FontFamily x:Key="MonoFace">/PixelThumbs;component/fonts/#JetBrains Mono</FontFamily>

    <DrawingBrush x:Key="Checker" TileMode="Tile" Stretch="None" ViewportUnits="Absolute" ViewboxUnits="Absolute"
                  Viewport="0,0,16,16" Viewbox="0,0,16,16">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#0A0A0A"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#131313" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LineHeight" Value="24"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFace}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="16"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource PanelRadius}"/>
    </Style>
    <Style x:Key="Rule" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Hairline}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,12"/>
    </Style>
    <Style x:Key="Glyph" TargetType="Path">
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Stroke" Value="{StaticResource Muted}"/>
    </Style>

    <Style x:Key="Command" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource MonoFace}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Background" Value="{StaticResource Hairline}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="27"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="opening" Text="[" Foreground="{StaticResource Quiet}" Margin="0,0,4,0"/>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            <TextBlock x:Name="closing" Text="]" Foreground="{StaticResource Quiet}" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="frame" Property="Background" Value="{StaticResource Frame}"/>
                            <Setter TargetName="frame" Property="BorderBrush" Value="{StaticResource HoverLine}"/>
                            <Setter TargetName="opening" Property="Foreground" Value="{StaticResource Cyan}"/>
                            <Setter TargetName="closing" Property="Foreground" Value="{StaticResource Cyan}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="frame" Property="Background" Value="{StaticResource HoverLine}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter Property="Foreground" Value="{StaticResource Sand}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter TargetName="frame" Property="Background" Value="{StaticResource Frame}"/>
                            <Setter TargetName="frame" Property="BorderBrush" Value="{StaticResource HoverLine}"/>
                            <Setter TargetName="opening" Property="Foreground" Value="{StaticResource Cyan}"/>
                            <Setter TargetName="closing" Property="Foreground" Value="{StaticResource Cyan}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Plain">
                            <Setter TargetName="opening" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="closing" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Paper">
                            <Setter Property="Foreground" Value="{StaticResource Canvas}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter TargetName="frame" Property="Background" Value="{StaticResource Sand}"/>
                            <Setter TargetName="frame" Property="BorderBrush" Value="{StaticResource Sand}"/>
                            <Setter TargetName="opening" Property="Foreground" Value="{StaticResource Canvas}"/>
                            <Setter TargetName="closing" Property="Foreground" Value="{StaticResource Canvas}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="{StaticResource FocusLine}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Disabled}"/>
                            <Setter TargetName="opening" Property="Foreground" Value="{StaticResource Disabled}"/>
                            <Setter TargetName="closing" Property="Foreground" Value="{StaticResource Disabled}"/>
                            <Setter TargetName="frame" Property="Background" Value="Transparent"/>
                            <Setter TargetName="frame" Property="BorderBrush" Value="{StaticResource Hairline}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppChoice" TargetType="RadioButton">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="entry" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="{StaticResource Radius}" Padding="7,6">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="entry" Property="Background" Value="{StaticResource Hairline}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Sand}"/>
                            <Setter TargetName="entry" Property="Background" Value="{StaticResource Frame}"/>
                            <Setter TargetName="entry" Property="BorderBrush" Value="{StaticResource HoverLine}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="entry" Property="BorderBrush" Value="{StaticResource FocusLine}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WidgetSwitch" TargetType="CheckBox">
        <Setter Property="Width" Value="34"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="track" Width="29" Height="16" Background="{StaticResource Raised}"
                                BorderBrush="{StaticResource HoverLine}" BorderThickness="1" CornerRadius="8">
                            <Ellipse x:Name="thumb" Width="8" Height="8" Margin="3,0" HorizontalAlignment="Left" Fill="{StaticResource Muted}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="#142921"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="#255541"/>
                            <Setter TargetName="thumb" Property="Fill" Value="{StaticResource Green}"/>
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource FocusLine}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Cyan}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowDot" TargetType="Button">
        <Setter Property="Width" Value="21"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="hit" Background="Transparent" CornerRadius="{StaticResource Radius}" BorderThickness="1">
                        <Ellipse x:Name="dot" Width="12" Height="12" Fill="{TemplateBinding Background}" Stroke="{StaticResource HoverLine}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="dot" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="1.2" ScaleY="1.2"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="hit" Property="BorderBrush" Value="{StaticResource FocusLine}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Sand}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Padding" Value="1,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="hit" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" x:Name="box" Width="14" Height="14" VerticalAlignment="Center" BorderBrush="{StaticResource HoverLine}"
                                    BorderThickness="1" CornerRadius="3" Background="{StaticResource Canvas}">
                                <Grid>
                                    <Path x:Name="check" Data="M2.5,6 L5,8.5 L9.5,3.5" Stroke="{StaticResource Cyan}" StrokeThickness="1.4" Visibility="Collapsed"/>
                                    <Path x:Name="dash" Data="M3,6 H9" Stroke="{StaticResource Cyan}" StrokeThickness="1.4" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource Frame}"/>
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="dash" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{StaticResource FocusLine}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="hit" Property="BorderBrush" Value="{StaticResource FocusLine}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="hit" Property="Opacity" Value=".45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource MonoFace}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Sand}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Sand}"/>
        <Setter Property="Background" Value="{StaticResource Canvas}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Frame}"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            <TextBlock x:Name="placeholder" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource Quiet}"
                                       Text="{TemplateBinding Tag}" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value=""><Setter TargetName="placeholder" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="{StaticResource FocusLine}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Row" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="line" Background="Transparent" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1">
                        <Border x:Name="focus" BorderThickness="1" BorderBrush="Transparent" Padding="7,2"><ContentPresenter/></Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="line" Property="Background" Value="{StaticResource Hairline}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="line" Property="Background" Value="{StaticResource Frame}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="BorderBrush" Value="{StaticResource FocusLine}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TrackButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="3" VerticalAlignment="Center" Background="{TemplateBinding Background}" CornerRadius="1"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ParameterLabel" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="25"/>
        <Setter Property="ToolTip" Value="Восстановить значение по умолчанию"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="label" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="0,0,0,1" Margin="0,3,0,3">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
                            <Setter TargetName="label" Property="BorderBrush" Value="{StaticResource Cyan}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="label" Property="BorderBrush" Value="{StaticResource Cyan}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Range" TargetType="Slider">
        <Setter Property="MinHeight" Value="25"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="IsSnapToTickEnabled" Value="True"/>
        <Setter Property="TickFrequency" Value="1"/>
        <Setter Property="SmallChange" Value="1"/>
        <Setter Property="LargeChange" Value="5"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Border x:Name="outline" BorderThickness="1" BorderBrush="Transparent" CornerRadius="4" Background="Transparent" Padding="3,0">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackButton}" Background="{StaticResource Quiet}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="12" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent"><Border Background="{StaticResource Sand}" Width="10" Height="10" CornerRadius="3"/></Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackButton}" Background="{StaticResource HoverLine}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="outline" Property="BorderBrush" Value="{StaticResource FocusLine}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="outline" Property="Opacity" Value=".4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DropdownItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Sand}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFace}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="row" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3"><ContentPresenter/></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="row" Property="Background" Value="{StaticResource Frame}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="FontWeight" Value="Bold"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Dropdown" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Sand}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFace}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource DropdownItem}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggle" Focusable="False" Cursor="Hand"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="frame" Background="{StaticResource Hairline}" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="8,3">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="{StaticResource HoverLine}"/></Trigger>
                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="{StaticResource FocusLine}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <DockPanel>
                                <Path DockPanel.Dock="Right" Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Muted}" StrokeThickness="1.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  IsHitTestVisible="False" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </DockPanel>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               PlacementTarget="{Binding ElementName=toggle}" Focusable="False">
                            <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Frame}" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius}" Padding="3"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                        <Border x:Name="focus" Visibility="Collapsed" IsHitTestVisible="False" BorderThickness="1"
                                CornerRadius="{StaticResource Radius}" BorderBrush="{StaticResource FocusLine}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="focus" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="toggle" Property="Opacity" Value=".45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton><RepeatButton Opacity="0" Focusable="False" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb MinHeight="18">
                                <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Border Width="4" HorizontalAlignment="Right" Margin="0,0,2,0" Background="#353432" CornerRadius="2"/></Grid></ControlTemplate></Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Opacity="0" Focusable="False" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
