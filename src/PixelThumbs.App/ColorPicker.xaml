<UserControl x:Class="PixelThumbs.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PaletteSwatch" TargetType="Button">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chip" Background="{TemplateBinding Background}" BorderBrush="#44000000"
                                BorderThickness="1" CornerRadius="4"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="chip" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="0,0,-4,0">
        <Grid x:Name="ColorArea" Height="144" Margin="0,0,4,0" ClipToBounds="True"
              Focusable="True" Cursor="Cross" AutomationProperties.Name="Насыщенность и яркость"
              MouseLeftButtonDown="ColorArea_Down" MouseMove="ColorArea_Move" MouseLeftButtonUp="ColorArea_Up"
              KeyDown="ColorArea_KeyDown" SizeChanged="ColorArea_SizeChanged">
            <Grid IsHitTestVisible="False">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="Black" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
            <Canvas IsHitTestVisible="False">
                <Grid x:Name="ColorMarker" Width="14" Height="14">
                    <Ellipse Stroke="Black" StrokeThickness="3"/>
                    <Ellipse Stroke="White" StrokeThickness="1.5" Margin="1"/>
                </Grid>
            </Canvas>
        </Grid>
        <Slider x:Name="Hue" Minimum="0" Maximum="360" SmallChange="1" LargeChange="15"
                Margin="0,8,4,10" IsMoveToPointEnabled="True" AutomationProperties.Name="Цветовой тон"
                ValueChanged="Hue_Changed">
            <Slider.Template>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" Height="22">
                        <Border Height="12" CornerRadius="4" Margin="6,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF0000" Offset="0"/>
                                    <GradientStop Color="#FFFF00" Offset="0.1667"/>
                                    <GradientStop Color="#00FF00" Offset="0.3333"/>
                                    <GradientStop Color="#00FFFF" Offset="0.5"/>
                                    <GradientStop Color="#0000FF" Offset="0.6667"/>
                                    <GradientStop Color="#FF00FF" Offset="0.8333"/>
                                    <GradientStop Color="#FF0000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Opacity="0" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="12" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border BorderBrush="Black" BorderThickness="1" CornerRadius="4">
                                                <Border BorderBrush="White" BorderThickness="2" CornerRadius="3"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Opacity="0" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Slider.Template>
        </Slider>
        <Grid Margin="0,0,4,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="108"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource Checker}" BorderThickness="1" BorderBrush="{DynamicResource Frame}"
                    CornerRadius="4" Margin="0,0,8,0">
                <Border x:Name="SelectedSwatch" CornerRadius="3"/>
            </Border>
            <TextBox x:Name="Hex" Grid.Column="1" MaxLength="7" Style="{DynamicResource Field}"
                     Background="{DynamicResource DialogField}" BorderBrush="{DynamicResource DialogLine}"
                     AutomationProperties.Name="Цвет HEX" TextChanged="Hex_Changed"/>
            <TextBlock x:Name="HexError" Grid.Column="2" Text="Формат #RRGGBB" Visibility="Collapsed"
                       Foreground="{DynamicResource Rose}" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </Grid>
        <TextBlock Text="ПАЛИТРА" Style="{DynamicResource Section}" Margin="0,0,0,5"/>
        <UniformGrid x:Name="Palette" Columns="8"/>
        <WrapPanel Margin="0,4,0,0">
            <Button x:Name="DefaultButton" Style="{DynamicResource Command}" Tag="Plain"
                    AutomationProperties.Name="Цвет по умолчанию" Click="Default_Click" Margin="0,0,5,4">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="DefaultSwatch" Width="11" Height="11" CornerRadius="2" Margin="0,0,6,0"/>
                    <TextBlock Text="Цвет по умолчанию"/>
                </StackPanel>
            </Button>
            <Button x:Name="TransparentButton" Content="Прозрачный фон" Style="{DynamicResource Command}"
                    Click="Transparent_Click" Margin="0,0,0,4"/>
        </WrapPanel>
    </StackPanel>
</UserControl>
