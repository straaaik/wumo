<Window x:Class="PixelThumbs.SettingsForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:motion="clr-namespace:PixelThumbs"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Wumo" Width="1342" Height="802" MinWidth="606" MinHeight="416"
        Background="#0A0A0A" WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" AutomationProperties.AutomationId="PixelThumbsSettings">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Ui/Cockpit.xaml"/>
                <ResourceDictionary Source="Ui/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="ModuleVisibility"/>
            <Style x:Key="CommandGlyph" TargetType="Path" BasedOn="{StaticResource Glyph}">
                <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Style>
            <Style x:Key="WidgetGlyph" TargetType="Path" BasedOn="{StaticResource Glyph}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource Cyan}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SettingsGear" TargetType="Button" BasedOn="{StaticResource Command}">
                <Setter Property="Width" Value="31"/>
                <Setter Property="Height" Value="27"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="frame" motion:UiMotion.Background="{TemplateBinding Background}"
                                    motion:UiMotion.BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius}">
                                <Viewbox x:Name="icon" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Canvas x:Name="gear" Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
                                        <Path Data="{StaticResource GearIcon}" Style="{StaticResource Glyph}" Stroke="{TemplateBinding Foreground}"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="frame" Property="motion:UiMotion.Background" Value="{StaticResource Frame}"/>
                                    <Setter TargetName="gear" Property="motion:UiMotion.Rotation" Value="22.5"/>
                                    <Setter Property="Foreground" Value="{StaticResource Sand}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="icon" Property="motion:UiMotion.Scale" Value="0.88"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="frame" Property="motion:UiMotion.BorderBrush" Value="{StaticResource FocusLine}"/>
                                </Trigger>
                                <Trigger Property="Tag" Value="Active">
                                    <Setter TargetName="frame" Property="motion:UiMotion.Background" Value="{StaticResource Frame}"/>
                                    <Setter TargetName="frame" Property="motion:UiMotion.BorderBrush" Value="{StaticResource HoverLine}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="frame" Property="motion:UiMotion.Opacity" Value=".45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="{StaticResource PanelRadius}"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource Canvas}" TextElement.FontFamily="{StaticResource Sans}" TextElement.Foreground="{StaticResource Sand}">
        <Border x:Name="Cockpit" Background="{StaticResource Canvas}" CornerRadius="{StaticResource PanelRadius}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Background="{StaticResource Bar}" Padding="12,0">
                    <DockPanel VerticalAlignment="Center">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0">
                            <Button Background="#BB293E" Style="{StaticResource WindowDot}" Click="Close_Click"
                                    AutomationProperties.Name="Закрыть" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                            <Button Background="#BB8A12" Style="{StaticResource WindowDot}" Click="Minimize_Click"
                                    AutomationProperties.Name="Свернуть" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                            <Button x:Name="MaximizeWindowButton" Background="#079D71" Style="{StaticResource WindowDot}"
                                    Click="Maximize_Click" AutomationProperties.Name="Развернуть"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        </StackPanel>
                        <Button x:Name="WumoSettingsButton" DockPanel.Dock="Right" Style="{StaticResource SettingsGear}"
                                AutomationProperties.Name="Настройки Wumo" ToolTip="Настройки Wumo"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="WumoSettings_Click"/>
                        <Button x:Name="RestartWumoButton" DockPanel.Dock="Right" Style="{StaticResource Command}"
                                Margin="0,0,8,0" MinHeight="27" Height="27"
                                ToolTip="Применить новую локальную сборку Wumo или перезапустить текущую"
                                AutomationProperties.AutomationId="RestartWumo" AutomationProperties.Name="Обновить / перезапустить"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="RestartWumo_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,6,0"><Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource RotateIcon}" Style="{StaticResource CommandGlyph}"/>
                                </Canvas></Viewbox>
                                <TextBlock Text="Обновить / перезапустить"/>
                            </StackPanel>
                        </Button>
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis"
                                       AutomationProperties.Name="Полоса заголовка Wumo">
                                <Run Text="Wumo" FontWeight="Bold"/><Run Text="  //  " Foreground="{StaticResource Quiet}"/>
                                <Run x:Name="SelectedApplicationName" Foreground="{StaticResource Muted}"/>
                            </TextBlock>
                        </Border>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="256"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border x:Name="ApplicationSidebar" Style="{StaticResource Card}" BorderThickness="0"
                            Margin="18,16,0,0" Padding="9,10" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="ВИДЖЕТЫ" Style="{StaticResource Section}" Margin="3,0,0,7"/>
                            <motion:WidgetChoice x:Name="PixelThumbsChoice" GroupName="Widgets" IsChecked="True"
                                                 Style="{StaticResource WidgetChoice}" AutomationProperties.Name="3D Thumbnails"
                                                 WidgetEnabledChanged="ThumbnailsWidget_Changed">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{StaticResource ModelIcon}" Style="{StaticResource WidgetGlyph}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding ElementName=PixelThumbsChoice, Path=(AutomationProperties.Name)}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </motion:WidgetChoice>
                            <motion:WidgetChoice x:Name="ClipboardChoice" GroupName="Widgets" Style="{StaticResource WidgetChoice}"
                                                 Margin="0,4,0,0" AutomationProperties.Name="История буфера обмена"
                                                 WidgetEnabledChanged="ClipboardWidget_Changed">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{StaticResource ClipboardIcon}" Style="{StaticResource WidgetGlyph}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding ElementName=ClipboardChoice, Path=(AutomationProperties.Name)}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </motion:WidgetChoice>
                        </StackPanel>
                    </Border>
                    <Grid x:Name="PixelThumbsModule" Grid.Column="1" Margin="12,16,18,0"
                          Visibility="{Binding IsChecked, ElementName=PixelThumbsChoice, Converter={StaticResource ModuleVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="ModuleNavigation" Style="{StaticResource Card}" Padding="8,7" Margin="0,0,0,12">
                            <Grid>
                                <Button x:Name="ThumbnailsTab" Style="{StaticResource Command}" Content="Миниатюры" Tag="Active" Width="118"
                                        HorizontalAlignment="Left" Click="Thumbnails_Click"/>
                                <Button x:Name="SettingsTab" Style="{StaticResource SettingsGear}" HorizontalAlignment="Right"
                                        AutomationProperties.Name="Настройки 3D Thumbnails" ToolTip="Настройки 3D Thumbnails" Click="Settings_Click"/>
                            </Grid>
                        </Border>
                        <Grid x:Name="WorkspaceArea" Grid.Row="1" Margin="0,0,0,12">
                            <ScrollViewer x:Name="WorkspaceScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                                <Grid x:Name="WorkspaceContent">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <UniformGrid x:Name="Summary" Columns="2" Margin="0,0,0,12">
                                        <Border Style="{StaticResource Card}" Padding="13,9" Margin="0,0,5,0">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" CornerRadius="4" Background="{StaticResource Hairline}" BorderBrush="{StaticResource Line}"
                                                        BorderThickness="1" Width="26" Height="26" VerticalAlignment="Top">
                                                    <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24">
                                                        <Path Data="{StaticResource LayersIcon}" Style="{StaticResource Glyph}" Stroke="{StaticResource Cyan}"/>
                                                    </Canvas></Viewbox>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="ДОСТУПНО ФОРМАТОВ" Style="{StaticResource Section}"/>
                                                    <TextBlock x:Name="TotalCount" Style="{StaticResource Mono}" FontSize="23" LineHeight="30" FontWeight="Bold"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}" Padding="13,9" Margin="5,0,0,0">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" CornerRadius="4" Background="#0C211A" BorderBrush="#164535"
                                                        BorderThickness="1" Width="26" Height="26" VerticalAlignment="Top">
                                                    <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24">
                                                        <Path Data="{StaticResource CheckIcon}" Style="{StaticResource Glyph}" Stroke="{StaticResource Green}"/>
                                                    </Canvas></Viewbox>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="ВКЛЮЧЕНО" Style="{StaticResource Section}"/>
                                                    <TextBlock x:Name="EnabledCount" Style="{StaticResource Mono}" FontSize="23" LineHeight="30"
                                                               FontWeight="Bold" Foreground="{StaticResource Green}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Grid x:Name="Workbench" Grid.Row="1">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <Border x:Name="FormatCard" Style="{StaticResource Card}" Padding="12" MinHeight="444">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Style="{StaticResource Title}" Text="Форматы" Margin="0,0,0,9"/>
                                                <Grid Grid.Row="1" Margin="0,0,0,7">
                                                    <TextBox x:Name="FormatSearch" AutomationProperties.Name="Поиск по расширению или названию"
                                                             Style="{StaticResource Field}" Tag="Поиск форматов…" Padding="30,0,9,0" TextChanged="Search_Changed"/>
                                                    <Viewbox Width="14" Height="14" HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False">
                                                        <Canvas Width="24" Height="24"><Path Data="{StaticResource SearchIcon}" Style="{StaticResource Glyph}"/></Canvas>
                                                    </Viewbox>
                                                </Grid>
                                                <CheckBox x:Name="AllFormats" Grid.Row="2" Content="Все форматы" Style="{StaticResource Check}" Click="AllFormats_Click" Margin="0,0,0,6"/>
                                                <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Canvas}" CornerRadius="{StaticResource Radius}" ClipToBounds="True">
                                                    <Grid>
                                                        <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                        <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"/>
                                                        <Grid Margin="8,0,7,0" VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="74"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="1" Text="ФОРМАТ" Style="{StaticResource Section}"/>
                                                            <TextBlock Grid.Column="2" Text="НАЗВАНИЕ" Style="{StaticResource Section}"/>
                                                        </Grid>
                                                        <ListBox x:Name="FormatList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
                                                                 AutomationProperties.Name="Расширения файлов" SelectionChanged="Format_Changed"
                                                                 ItemContainerStyle="{StaticResource Row}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid MinHeight="26" ToolTip="{Binding Detail}">
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="74"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                                        <CheckBox Style="{StaticResource Check}" VerticalAlignment="Center" IsChecked="{Binding Enabled,Mode=TwoWay}"
                                                                                  AutomationProperties.Name="{Binding Extension}" HorizontalAlignment="Left"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Extension}" Style="{StaticResource Mono}" VerticalAlignment="Center"
                                                                                   FontWeight="Bold" Foreground="{StaticResource Sand}"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Secondary}"
                                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                        <TextBlock x:Name="EmptyFormats" Grid.Row="1" Text="Ничего не найдено" Style="{StaticResource Hint}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="8"/>
                                                    </Grid>
                                                </Border>
                                                <Button x:Name="GeneralStyleButton" Grid.Row="4" Style="{StaticResource Command}" Content="Общий стиль" Tag="Active"
                                                        Click="GeneralStyle_Click" Margin="0,9,0,0"/>
                                            </Grid>
                                        </Border>

                                        <Border x:Name="StyleCard" Style="{StaticResource Card}" Padding="13" MinHeight="444">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel Margin="0,0,5,0">
                                                    <TextBlock x:Name="EditorTitle" Style="{StaticResource Title}"/>
                                                    <TextBlock x:Name="EditorDetail" Style="{StaticResource Hint}" Margin="0,3,0,9"/>
                                                    <StackPanel x:Name="FormatOptions">
                                                        <CheckBox x:Name="FormatEnabled" Content="Показывать миниатюру" Style="{StaticResource Check}" Click="FormatEnabled_Click"/>
                                                        <CheckBox x:Name="CustomStyle" Content="Собственный стиль" Style="{StaticResource Check}" Click="CustomStyle_Click"/>
                                                        <Border Style="{StaticResource Rule}" Margin="0,8"/>
                                                    </StackPanel>
                                                    <StackPanel x:Name="StyleFields">
                                                        <TextBlock Text="МОДЕЛЬ И ФОН" Style="{StaticResource Section}" Margin="0,0,0,7"/>
                                                        <Border Style="{StaticResource Card}" Background="{StaticResource Canvas}" Padding="8,6" Margin="0,0,0,8">
                                                            <StackPanel>
                                                                <DockPanel Margin="0,0,0,5">
                                                                    <Button x:Name="ModelColor" DockPanel.Dock="Right" MinWidth="110" Style="{StaticResource Command}"
                                                                            Tag="Plain" AutomationProperties.Name="Цвет модели" Click="ModelColor_Click">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Border x:Name="ModelSwatch" Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0"/>
                                                                            <TextBlock x:Name="ModelHex"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <TextBlock Text="Цвет модели" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                </DockPanel>
                                                                <DockPanel>
                                                                    <Button x:Name="BackgroundColor" DockPanel.Dock="Right" MinWidth="110" Style="{StaticResource Command}"
                                                                            Tag="Plain" AutomationProperties.Name="Цвет фона" Click="BackgroundColor_Click">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Border x:Name="BackgroundSwatch" Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0"/>
                                                                            <TextBlock x:Name="BackgroundHex"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <TextBlock Text="Цвет фона" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                </DockPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <CheckBox x:Name="TransparentBackground" Content="Прозрачный фон" Style="{StaticResource Check}" Click="StyleOptions_Click"/>
                                                        <CheckBox x:Name="SourceColors" Content="Цвета из файла" Style="{StaticResource Check}" Click="StyleOptions_Click"
                                                                  ToolTip="Использует цвета геометрии, если они есть в файле."/>
                                                        <CheckBox x:Name="PreferEmbedded" Content="Сначала готовая картинка" Style="{StaticResource Check}" Click="StyleOptions_Click"
                                                                  ToolTip="Ракурс и цвет модели применяются, если миниатюра строится из геометрии."/>
                                                        <Border Style="{StaticResource Rule}"/>
                                                        <TextBlock Text="РАКУРС И СВЕТ" Style="{StaticResource Section}" Margin="0,0,0,5"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="91"/><ColumnDefinition Width="*"/><ColumnDefinition Width="43"/></Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                            <Button x:Name="ResetYaw" Grid.Row="0" Content="Ракурс" Style="{StaticResource ParameterLabel}"
                                                                    AutomationProperties.Name="Сбросить ракурс" Click="ResetParameter_Click"/>
                                                            <Button x:Name="ResetPitch" Grid.Row="1" Content="Наклон" Style="{StaticResource ParameterLabel}"
                                                                    AutomationProperties.Name="Сбросить наклон" Click="ResetParameter_Click"/>
                                                            <Button x:Name="ResetLighting" Grid.Row="2" Content="Освещение" Style="{StaticResource ParameterLabel}"
                                                                    AutomationProperties.Name="Сбросить освещение" Click="ResetParameter_Click"/>
                                                            <Button x:Name="ResetMargin" Grid.Row="3" Content="Отступ" Style="{StaticResource ParameterLabel}"
                                                                    AutomationProperties.Name="Сбросить отступ" Click="ResetParameter_Click"/>
                                                            <Slider x:Name="Yaw" Grid.Column="1" Minimum="-180" Maximum="360" Style="{StaticResource Range}" ValueChanged="StyleSlider_Changed" AutomationProperties.Name="Ракурс"/>
                                                            <Slider x:Name="Pitch" Grid.Column="1" Grid.Row="1" Minimum="-90" Maximum="90" Style="{StaticResource Range}" ValueChanged="StyleSlider_Changed" AutomationProperties.Name="Наклон"/>
                                                            <Slider x:Name="Lighting" Grid.Column="1" Grid.Row="2" Maximum="100" Style="{StaticResource Range}" ValueChanged="StyleSlider_Changed" AutomationProperties.Name="Освещение"/>
                                                            <Slider x:Name="MarginSlider" Grid.Column="1" Grid.Row="3" Maximum="35" Style="{StaticResource Range}" ValueChanged="StyleSlider_Changed" AutomationProperties.Name="Отступ"/>
                                                            <TextBlock x:Name="YawValue" Grid.Column="2" Style="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="PitchValue" Grid.Column="2" Grid.Row="1" Style="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="LightingValue" Grid.Column="2" Grid.Row="2" Style="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="MarginValue" Grid.Column="2" Grid.Row="3" Style="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <Button x:Name="ResetView" Style="{StaticResource Command}" Content="Сбросить параметры вида" Click="ResetView_Click" Margin="0,7,0,0"/>
                                                        <Border Style="{StaticResource Rule}"/>
                                                        <TextBlock Text="ГОТОВЫЕ СТИЛИ" Style="{StaticResource Section}" Margin="0,0,0,6"/>
                                                        <ItemsControl x:Name="StylePresets">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource Command}" Tag="Plain" AutomationProperties.Name="{Binding Name}"
                                                                            Click="Preset_Click" Margin="0,0,5,4">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Swatch}" Margin="0,0,6,0"/>
                                                                            <TextBlock Text="{Binding Name}"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>

                                        <Border x:Name="PreviewCard" Style="{StaticResource Card}" Padding="12" MinHeight="404">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <DockPanel Margin="0,0,0,9">
                                                    <ComboBox x:Name="PreviewSize" DockPanel.Dock="Right" Width="78" Style="{StaticResource Dropdown}" SelectionChanged="PreviewSize_Changed"
                                                              AutomationProperties.Name="Размер миниатюры"/>
                                                    <TextBlock Text="Предпросмотр" Style="{StaticResource Title}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                </DockPanel>
                                                <Border Grid.Row="1" Style="{StaticResource Card}" Background="{StaticResource Checker}" ClipToBounds="True" MinHeight="233">
                                                    <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" Margin="10"
                                                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Изображение миниатюры"/>
                                                </Border>
                                                <StackPanel Grid.Row="2" Margin="0,10,0,11">
                                                    <TextBlock x:Name="PreviewName" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="PreviewStatus" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="3">
                                                    <WrapPanel Margin="0,0,0,5">
                                                        <Button x:Name="OpenModel" Style="{StaticResource Command}" Margin="0,0,5,4" Click="OpenModel_Click"
                                                                AutomationProperties.Name="Открыть модель">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Viewbox Width="13" Height="13" Margin="0,0,5,0"><Canvas Width="24" Height="24">
                                                                    <Path Data="{StaticResource FolderIcon}" Style="{StaticResource Glyph}"/>
                                                                </Canvas></Viewbox>
                                                                <TextBlock Text="Открыть модель…"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource Command}" Margin="0,0,0,4" Click="Sample_Click"
                                                                AutomationProperties.Name="Образец">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Viewbox Width="13" Height="13" Margin="0,0,5,0"><Canvas Width="24" Height="24">
                                                                    <Path Data="{StaticResource ModelIcon}" Style="{StaticResource CommandGlyph}"/>
                                                                </Canvas></Viewbox>
                                                                <TextBlock Text="Образец"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </WrapPanel>
                                                    <Button x:Name="RefreshThumbnail" Style="{StaticResource Command}" Click="Refresh_Click"
                                                            IsEnabled="False" AutomationProperties.Name="Обновить значок">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Viewbox Width="13" Height="13" Margin="0,0,6,0"><Canvas Width="24" Height="24">
                                                                <Path Data="{StaticResource ImageIcon}" Style="{StaticResource CommandGlyph}"/>
                                                            </Canvas></Viewbox>
                                                            <TextBlock Text="Обновить значок"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>

                            <ScrollViewer x:Name="WidgetSettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                                <Border x:Name="QuickCard" Style="{StaticResource Card}" Padding="15" MaxWidth="650" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="Быстрый просмотр" Style="{StaticResource Title}"/>
                                        <TextBlock Text="Пробел показывает выделенную модель. Для другой кнопки наведите курсор на модель." TextWrapping="Wrap" Style="{StaticResource Hint}" Margin="0,4,0,9"/>
                                        <CheckBox x:Name="QuickPreviewEnabled" Content="Включить быстрый просмотр" Style="{StaticResource Check}" Click="QuickPreview_Click"/>
                                        <Border Style="{StaticResource Rule}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="Кнопка" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                            <WrapPanel Grid.Column="1" Margin="0,0,0,6">
                                                <Border Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="8,4"
                                                        CornerRadius="{StaticResource Radius}" VerticalAlignment="Center" Margin="0,0,5,0">
                                                    <TextBlock x:Name="QuickPreviewKey" Style="{StaticResource Mono}" FontWeight="Bold" AutomationProperties.AutomationId="QuickPreviewKey"/>
                                                </Border>
                                                <Button x:Name="ChangeQuickPreviewKey" Style="{StaticResource Command}" Content="Изменить"
                                                        AutomationProperties.Name="Изменить кнопку быстрого просмотра" Click="ChangeHotkey_Click"/>
                                            </WrapPanel>
                                            <TextBlock Grid.Row="1" Text="Размер окна" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox x:Name="QuickPreviewSize" Grid.Row="1" Grid.Column="1" Width="142" HorizontalAlignment="Left" Style="{StaticResource Dropdown}"
                                                      SelectionChanged="QuickPreviewSize_Changed" AutomationProperties.Name="Размер окна быстрого просмотра"/>
                                        </Grid>
                                        <TextBlock x:Name="CapturePrompt" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </Grid>
                        <Border x:Name="WidgetOffNotice" Grid.Row="1" Style="{StaticResource Card}" Padding="15"
                                Margin="0,0,0,12" VerticalAlignment="Top" Visibility="Collapsed">
                            <TextBlock Text="Виджет выключен" Style="{StaticResource Title}"/>
                        </Border>
                    </Grid>
                    <ScrollViewer x:Name="ClipboardPage" Grid.Column="1" Margin="12,16,18,12" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsChecked, ElementName=ClipboardChoice, Converter={StaticResource ModuleVisibility}}">
                        <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock Text="История буфера обмена" Style="{StaticResource Title}" Margin="0,0,0,10"/>
                            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Типы данных" Style="{StaticResource Section}" Margin="0,0,0,9"/>
                                    <CheckBox x:Name="ClipboardText" Content="Текст" Style="{StaticResource Check}" Click="ClipboardOptions_Click" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="ClipboardImages" Content="Изображения" Style="{StaticResource Check}" Click="ClipboardOptions_Click" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="ClipboardFiles" Content="Файлы и папки" Style="{StaticResource Check}" Click="ClipboardOptions_Click" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="ClipboardOther" Content="Прочее" Style="{StaticResource Check}" Click="ClipboardOptions_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Положение панели" Style="{StaticResource Section}" Margin="0,0,0,9"/>
                                    <ComboBox x:Name="ClipboardDockEdge" Style="{StaticResource Dropdown}" HorizontalAlignment="Left"
                                              MinWidth="190" Margin="0,0,0,7" AutomationProperties.Name="Край экрана"
                                              SelectionChanged="ClipboardMode_Changed">
                                        <ComboBoxItem Content="Справа"/>
                                        <ComboBoxItem Content="Слева"/>
                                        <ComboBoxItem Content="Сверху"/>
                                        <ComboBoxItem Content="Снизу"/>
                                    </ComboBox>
                                    <ComboBox x:Name="ClipboardMonitor" Style="{StaticResource Dropdown}" HorizontalAlignment="Left"
                                              MinWidth="190" DisplayMemberPath="Label" SelectedValuePath="Device"
                                              AutomationProperties.Name="Монитор" SelectionChanged="ClipboardMode_Changed" Margin="0,0,0,8"/>
                                    <Button x:Name="ClipboardPreview" Style="{StaticResource Command}" HorizontalAlignment="Left"
                                            AutomationProperties.Name="Показать панель"
                                            IsEnabled="{Binding WidgetEnabled, ElementName=ClipboardChoice}" Click="ClipboardPreview_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="13" Height="13" Margin="0,0,6,0"><Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource PanelIcon}" Style="{StaticResource CommandGlyph}"/>
                                            </Canvas></Viewbox>
                                            <TextBlock Text="Показать панель"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Хранение истории" Style="{StaticResource Section}" Margin="0,0,0,9"/>
                                    <CheckBox x:Name="ClipboardPersist" Content="Сохранять историю между запусками" Style="{StaticResource Check}"
                                              Click="ClipboardOptions_Click" Margin="0,0,0,9"/>
                                    <TextBlock Text="Автоудаление записей истории" Style="{StaticResource Hint}" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="ClipboardExpire" Style="{StaticResource Dropdown}" HorizontalAlignment="Left"
                                              MinWidth="190" AutomationProperties.Name="Автоудаление записей"
                                              SelectionChanged="ClipboardMode_Changed">
                                        <ComboBoxItem Content="Выключено"/>
                                        <ComboBoxItem Content="Через час"/>
                                        <ComboBoxItem Content="Через 6 часов"/>
                                        <ComboBoxItem Content="Через сутки"/>
                                        <ComboBoxItem Content="Через 7 дней"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="WumoSettingsPage" Grid.Column="1" Margin="12,16,18,12" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="650" HorizontalAlignment="Left">
                            <TextBlock Text="Настройки Wumo" Style="{StaticResource Title}" Margin="0,0,0,12"/>
                            <Border Style="{StaticResource Card}" Padding="15">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,8,0"><Canvas Width="24" Height="24">
                                            <Path Data="{StaticResource PowerIcon}" Style="{StaticResource Glyph}"/>
                                        </Canvas></Viewbox>
                                        <TextBlock Text="Автозапуск" Style="{StaticResource Title}"/>
                                    </StackPanel>
                                    <TextBlock Text="Wumo открывается в трее при входе в Windows." TextWrapping="Wrap"
                                               Style="{StaticResource Hint}" Margin="0,4,0,8"/>
                                    <CheckBox x:Name="AutoStart" Content="Запускать с Windows" Style="{StaticResource Check}" Click="AutoStart_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" Grid.Column="1" Margin="12,0,18,16" Style="{StaticResource Card}" Background="{StaticResource Bar}" Padding="12,7">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <DockPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <Ellipse x:Name="StatusDot" DockPanel.Dock="Left" Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusLine" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <Button x:Name="SaveSettingsButton" Grid.Column="1" Style="{StaticResource Command}" Tag="Paper" MinWidth="124"
                                    Click="SaveSettings_Click" AutomationProperties.AutomationId="SaveSettings"
                                    AutomationProperties.Name="Применить" ToolTip="Ctrl+S">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="13" Height="13" Margin="0,0,6,0"><Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource CheckIcon}" Style="{StaticResource CommandGlyph}"/>
                                    </Canvas></Viewbox>
                                    <TextBlock Text="Применить"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <Border x:Name="DialogShade" Background="#D9000000" motion:UiMotion.Opacity="0" IsHitTestVisible="False" Panel.ZIndex="3"/>
    </Grid>
</Window>
