<Window x:Class="PixelThumbs.ClipboardHistory.ClipboardShelf" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:motion="clr-namespace:PixelThumbs"
        Title="История буфера обмена" Width="352" Height="514"
        WindowStyle="None" ResizeMode="NoResize" ShowActivated="False" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Topmost="True" UseLayoutRounding="True"
        AutomationProperties.AutomationId="ClipboardShelf">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Ui/Cockpit.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ItemsPanelTemplate x:Key="VerticalShelfCards">
                <VirtualizingStackPanel Orientation="Vertical"/>
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="HorizontalShelfCards">
                <VirtualizingStackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
            <Geometry x:Key="AllGlyph">M 2,2 H 6 V 6 H 2 Z M 10,2 H 14 V 6 H 10 Z M 2,10 H 6 V 14 H 2 Z M 10,10 H 14 V 14 H 10 Z</Geometry>
            <Geometry x:Key="TextGlyph">M 2,3 H 14 M 2,6.3 H 11 M 2,9.7 H 14 M 2,13 H 8</Geometry>
            <Geometry x:Key="LinkGlyph">M 7,4.5 L 9.4,2.1 A 3.18,3.18 0 0 1 13.9,6.6 L 11.5,9 M 9,11.5 L 6.6,13.9 A 3.18,3.18 0 0 1 2.1,9.4 L 4.5,7 M 5.5,10.5 L 10.5,5.5</Geometry>
            <Geometry x:Key="ImageGlyph">M 2,2.5 H 14 V 13.5 H 2 Z M 2,11 L 5.5,7.5 L 8.4,10.4 L 10.6,8.2 L 14,11.6 M 10.75,5.7 H 10.9</Geometry>
            <Geometry x:Key="FileGlyph">M 3,1.5 H 9 L 13,5.5 V 14.5 H 3 Z M 9,1.5 V 5.5 H 13 M 5.5,9 H 10.5 M 5.5,11.5 H 9</Geometry>
            <Geometry x:Key="OtherGlyph">M 2.5,8 H 2.7 M 7.9,8 H 8.1 M 13.3,8 H 13.5</Geometry>
            <Geometry x:Key="StarGlyph">M 8,1.4 L 10,5.7 L 14.8,6.4 L 11.4,9.7 L 12.2,14.5 L 8,12.2 L 3.8,14.5 L 4.6,9.7 L 1.2,6.4 L 6,5.7 Z</Geometry>
            <Geometry x:Key="FolderGlyph">M 1.5,4 H 6 L 7.5,6 H 14.5 V 13 H 1.5 Z</Geometry>
            <Geometry x:Key="TrashGlyph">M 2,4 L 14,4 M 6,4 L 6,2 L 10,2 L 10,4 M 3.5,4 L 4.5,14 L 11.5,14 L 12.5,4 M 6.5,7 L 6.7,11.5 M 9.5,7 L 9.3,11.5</Geometry>
            <Geometry x:Key="SearchGlyph">M 12,7 A 5,5 0 1 1 2,7 A 5,5 0 1 1 12,7 M 10.5,10.5 L 14,14</Geometry>
            <Geometry x:Key="CopiedGlyph">M 2,7 L 6,11 L 14,3</Geometry>
            <Style x:Key="ShelfGlyph" TargetType="Path">
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="StrokeThickness" Value="1.5"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
            </Style>
            <Style x:Key="ShelfAction" TargetType="Button">
                <Setter Property="Width" Value="27"/>
                <Setter Property="Height" Value="27"/>
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ActionFrame" motion:UiMotion.Background="{TemplateBinding Background}"
                                    BorderThickness="1" motion:UiMotion.BorderBrush="Transparent" CornerRadius="7">
                                <ContentPresenter x:Name="ActionIcon" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RenderTransformOrigin=".5,.5"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ActionFrame" Property="motion:UiMotion.Background" Value="{StaticResource Frame}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Sand}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="ActionFrame" Property="motion:UiMotion.BorderBrush" Value="{StaticResource FocusLine}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ActionFrame" Property="motion:UiMotion.Background" Value="{StaticResource HoverLine}"/>
                                    <Setter TargetName="ActionIcon" Property="motion:UiMotion.Scale" Value=".88"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value=".4"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CardAction" TargetType="Button" BasedOn="{StaticResource ShelfAction}">
                <Setter Property="Width" Value="23"/>
                <Setter Property="Height" Value="22"/>
            </Style>
            <Style x:Key="ShelfName" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="MaxLength" Value="160"/>
                <Setter Property="MaxHeight" Value="72"/>
                <Setter Property="Padding" Value="3,1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{StaticResource Sand}"/>
                <Setter Property="CaretBrush" Value="{StaticResource Sand}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="NameFrame" motion:UiMotion.Background="Transparent" BorderThickness="1"
                                    motion:UiMotion.BorderBrush="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="5">
                                <Grid>
                                    <TextBlock x:Name="NameLabel" Text="{TemplateBinding Text}" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"/>
                                    <ScrollViewer x:Name="PART_ContentHost" Visibility="Collapsed" MinHeight="18"
                                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="NameFrame" Property="motion:UiMotion.Background" Value="{StaticResource Raised}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="NameFrame" Property="motion:UiMotion.BorderBrush" Value="{StaticResource FocusLine}"/>
                                </Trigger>
                                <Trigger Property="IsReadOnly" Value="False">
                                    <Setter Property="Cursor" Value="IBeam"/>
                                    <Setter TargetName="NameFrame" Property="motion:UiMotion.Background" Value="{StaticResource Canvas}"/>
                                    <Setter TargetName="NameLabel" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="PART_ContentHost" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsHitTestVisible" Value="True">
                        <Setter Property="AutomationProperties.HelpText" Value="Щёлкните, чтобы изменить название"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="MorphRoot" Background="{StaticResource Canvas}">
        <Grid.Clip><RectangleGeometry x:Name="Silhouette"/></Grid.Clip>
        <Path Data="{Binding ElementName=MorphRoot, Path=Clip}" Stroke="{StaticResource Frame}" StrokeThickness="1.5"
              IsHitTestVisible="False" Stretch="None"/>
        <Border x:Name="Surface" Padding="12" TextElement.FontFamily="{StaticResource Sans}"
                TextElement.Foreground="{StaticResource Sand}" Opacity="0" Visibility="Hidden">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="Toolbar" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel x:Name="ToolbarActions" Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path x:Name="ToolbarCopied" Width="12" Height="12" Margin="0,0,6,0" Opacity="0" IsHitTestVisible="False"
                          Style="{StaticResource ShelfGlyph}" Data="{StaticResource CopiedGlyph}" Stroke="{StaticResource Cyan}"/>
                    <TextBlock x:Name="CategoryCount" Width="23" Text="0" FontSize="11" TextAlignment="Right"
                               VerticalAlignment="Center" Foreground="{StaticResource Muted}" ToolTip="Записей в категории"/>
                    <Button x:Name="ClearShelf" Style="{StaticResource ShelfAction}" Click="Clear_Click"
                            AutomationProperties.Name="Очистить историю" ToolTip="Очистить историю">
                        <Path Width="15" Height="16" Style="{StaticResource ShelfGlyph}" Data="{StaticResource TrashGlyph}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            <Grid x:Name="SearchSlot" Grid.Column="1" HorizontalAlignment="Center">
                <TextBox x:Name="Search" Style="{StaticResource Field}" Tag="Поиск" FontFamily="{StaticResource Sans}" FontSize="11"
                         Padding="24,0,6,0" MinHeight="28" AutomationProperties.Name="Поиск по истории"
                         TextChanged="Search_Changed"/>
                <Path Width="12" Height="12" Margin="7,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                      IsHitTestVisible="False" Style="{StaticResource ShelfGlyph}" Data="{StaticResource SearchGlyph}" Stroke="{StaticResource Muted}"/>
            </Grid>
            <ListBox x:Name="Categories" HorizontalAlignment="Left" VerticalAlignment="Center"
                     SelectionChanged="Category_Changed" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False"
                     AutomationProperties.Name="Категории"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Path Width="14" Height="14" Style="{StaticResource ShelfGlyph}" Data="{Binding Icon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                        <Setter Property="Width" Value="24"/>
                        <Setter Property="Height" Value="27"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="ToolTip" Value="{Binding Name}"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Pill" motion:UiMotion.Background="Transparent" BorderThickness="1"
                                            motion:UiMotion.BorderBrush="Transparent" CornerRadius="6" Margin="1,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Pill" Property="motion:UiMotion.Background" Value="{StaticResource Raised}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Pill" Property="motion:UiMotion.BorderBrush" Value="{StaticResource FocusLine}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Pill" Property="motion:UiMotion.Background" Value="{StaticResource Frame}"/>
                                            <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            </Grid>
            <DockPanel x:Name="FolderNavigation" Grid.Row="1" Margin="0,0,0,9" Visibility="Collapsed">
                <Button DockPanel.Dock="Left" Style="{StaticResource ShelfAction}" Click="Back_Click"
                        ToolTip="Назад" AutomationProperties.Name="Назад">
                    <Path Width="13" Height="13" Style="{StaticResource ShelfGlyph}" Data="M 13,8 H 3 L 8,3 M 3,8 L 8,13"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <TextBox x:Name="FolderTitle" Style="{StaticResource ShelfName}" VerticalAlignment="Center" Margin="2,0,0,0"
                         Text="{Binding Title, Mode=OneWay}" AutomationProperties.Name="Название папки"
                         PreviewMouseDown="Name_MouseDown" PreviewKeyDown="Name_KeyDown" LostKeyboardFocus="Name_LostFocus"/>
            </DockPanel>
            <ListBox x:Name="Entries" Grid.Row="2" BorderThickness="0" Padding="0" Background="Transparent"
                     PreviewMouseWheel="Entries_MouseWheel"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Записи истории">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Background="{StaticResource Bar}" motion:UiMotion.BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="13" Padding="12"
                                Margin="{DynamicResource ShelfCardGap}" Width="{DynamicResource ShelfCardWidth}"
                                Loaded="Entry_Loaded" DataContextChanged="Entry_Changed"
                                AutomationProperties.Name="{Binding Title}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" VerticalAlignment="Top" CornerRadius="9" Margin="0,0,9,0"
                                            Background="{StaticResource Frame}">
                                        <Path Width="19" Height="19" Style="{StaticResource ShelfGlyph}" Data="{Binding Icon}"
                                              Stroke="{StaticResource Cyan}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox x:Name="EntryText" Style="{StaticResource ShelfName}" Text="{Binding Title, Mode=OneWay}"
                                                 Margin="-4,0,0,0" Focusable="{Binding CanRename}" IsHitTestVisible="{Binding CanRename}"
                                                 AutomationProperties.Name="{Binding Title}"
                                                 PreviewMouseDown="Name_MouseDown" PreviewKeyDown="Name_KeyDown" LostKeyboardFocus="Name_LostFocus"/>
                                        <DockPanel Margin="0,3,0,0" LastChildFill="False">
                                            <Button x:Name="RemoveCard" DockPanel.Dock="Right" Style="{StaticResource CardAction}" Click="Remove_Click"
                                                    ToolTip="{Binding RemoveTitle}" AutomationProperties.Name="{Binding RemoveTitle}">
                                                <Path Width="12" Height="13" Style="{StaticResource ShelfGlyph}" Data="{StaticResource TrashGlyph}"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Button>
                                            <Button x:Name="PinCard" DockPanel.Dock="Right" Style="{StaticResource CardAction}" Click="Pin_Click"
                                                    Visibility="{Binding EntryActions}" ToolTip="{Binding PinTitle}" AutomationProperties.Name="{Binding PinTitle}">
                                                <Path x:Name="PinIcon" Width="13" Height="13" Style="{StaticResource ShelfGlyph}" Data="{StaticResource StarGlyph}"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Button>
                                            <Border x:Name="Badge" Background="{StaticResource Frame}" CornerRadius="4"
                                                    Margin="0,0,5,0" Padding="4,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Badge}" Foreground="{StaticResource Cyan}" FontFamily="{StaticResource MonoFace}" FontSize="9"/>
                                            </Border>
                                            <TextBlock Text="{Binding Meta}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>
                                <Border x:Name="PreviewWell" Background="{StaticResource Canvas}" CornerRadius="8" Padding="4" Margin="0,9,0,0">
                                    <Image Source="{Binding Thumbnail}" Height="{DynamicResource ShelfPreviewHeight}" Stretch="Uniform"/>
                                </Border>
                                <TextBlock x:Name="Details" Text="{Binding Details}" Foreground="{StaticResource Muted}" FontSize="11"
                                           TextWrapping="Wrap" MaxHeight="29" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"
                                           ToolTip="{Binding Details}"/>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                <Setter TargetName="PreviewWell" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Badge}" Value="">
                                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Details}" Value="">
                                <Setter TargetName="Details" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="motion:UiMotion.BorderBrush" Value="{StaticResource HoverLine}"/>
                            </Trigger>
                            <Trigger SourceName="Card" Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Card" Property="motion:UiMotion.BorderBrush" Value="{StaticResource FocusLine}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                <Setter TargetName="PinIcon" Property="Stroke" Value="{StaticResource Cyan}"/>
                                <Setter TargetName="PinIcon" Property="Fill" Value="{StaticResource Cyan}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="Card" Property="motion:UiMotion.BorderBrush" Value="{StaticResource Cyan}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="Empty" Grid.Row="2" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"
                       Style="{StaticResource Hint}" IsHitTestVisible="False"/>
            <Border x:Name="DropTarget" Grid.Row="2" Background="{StaticResource Frame}" BorderBrush="{StaticResource Cyan}"
                    BorderThickness="1" CornerRadius="9" Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="↓" Foreground="{StaticResource Cyan}" FontSize="26" HorizontalAlignment="Center"/>
                    <TextBlock Text="Добавить в историю" Style="{StaticResource Title}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="Status" Grid.Row="3" Foreground="{StaticResource Cyan}" FontSize="11"
                       Visibility="Collapsed" Margin="1,5,0,0" TextWrapping="Wrap"/>
        </Grid>
        </Border>
        <Canvas IsHitTestVisible="False">
            <Path x:Name="TabCopied" Width="12" Height="12" Opacity="0"
                  Style="{StaticResource ShelfGlyph}" Data="{StaticResource CopiedGlyph}" Stroke="{StaticResource Cyan}"/>
        </Canvas>
    </Grid>
</Window>
